{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "milestone_id": { "type": "string", "pattern": "^M[0-9]{2,3}$" },
    "summary": { "type": "string", "minLength": 1 },
    "changed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests_added_or_updated": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "commands_run": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "known_issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schema_version",
    "milestone_id",
    "summary",
    "changed_files",
    "tests_added_or_updated",
    "commands_run",
    "known_issues"
  ]
}
