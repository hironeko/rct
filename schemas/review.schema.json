{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "review_type": {
      "type": "string",
      "enum": [
        "requirements",
        "architecture",
        "plan",
        "code",
        "final"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "application/json",
            "text/markdown"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "feasibility": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "testability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "risk_control": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "clarity",
        "completeness",
        "feasibility",
        "testability",
        "risk_control"
      ]
    },
    "required_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "target",
          "problem",
          "rationale",
          "expected_outcome"
        ]
      }
    },
    "optional_suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "approved"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "required_changes": {
            "maxItems": 0
          },
          "open_questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "changes_requested"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "required_changes": {
            "minItems": 1
          },
          "open_questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "open_questions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "run_id",
    "job_id",
    "review_type",
    "subject",
    "verdict",
    "summary",
    "scores",
    "required_changes",
    "optional_suggestions",
    "open_questions"
  ]
}
